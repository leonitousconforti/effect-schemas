{
    "name": "effect-schemas",
    "version": "0.0.27",
    "description": "Shared schemas for Effect-TS",
    "keywords": [
        "effect-ts"
    ],
    "homepage": "https://github.com/leonitousconforti/effect-schemas",
    "bugs": {
        "url": "https://github.com/leonitousconforti/effect-schemas/issues",
        "email": "leo@leoconforti.us"
    },
    "license": "GPL-3.0-only",
    "author": "Leo Conforti <leo@leoconforti.us> (https://leoconforti.us)",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/leonitousconforti/effect-schemas.git"
    },
    "files": [
        "src/**/*.ts",
        "dist/**/*.js",
        "dist/**/*.js.map",
        "dist/**/*.d.ts",
        "dist/**/*.d.ts.map"
    ],
    "type": "module",
    "sideEffects": [],
    "exports": {
        "./package.json": "./package.json",
        ".": "./src/index.ts",
        "./*": "./src/*.ts",
        "./internal/*": null,
        "./*/index": null
    },
    "publishConfig": {
        "exports": {
            "./package.json": "./package.json",
            ".": "./dist/index.js",
            "./*": "./dist/*.js",
            "./internal/*": null,
            "./*/index": null
        },
        "access": "public",
        "provenance": true
    },
    "scripts": {
        "prepare": "effect-tsgo patch --typescript --oxlint",
        "clean": "rimraf *.tsbuildinfo docs dist coverage",
        "circular": "madge --circular src/*.ts",
        "codegen": "build-utils prepare-v4",
        "check": "tsc -b tsconfig.json",
        "lint": "oxlint && oxfmt --check",
        "lint-fix": "oxlint --fix && oxfmt --write",
        "build": "tsc -b tsconfig.build.json && pnpm babel",
        "babel": "babel dist --plugins annotate-pure-calls --out-dir dist --source-maps",
        "changeset-version": "changeset version",
        "changeset-publish": "pnpm build && changeset publish"
    },
    "devDependencies": {
        "@babel/cli": "8.0.4",
        "@babel/core": "8.0.1",
        "@babel/plugin-transform-export-namespace-from": "8.0.1",
        "@babel/plugin-transform-modules-commonjs": "8.0.1",
        "@changesets/cli": "3.0.2",
        "@changesets/config": "4.0.0",
        "@effect/build-utils": "0.8.9",
        "@effect/docgen": "4.0.0-rc.115",
        "@effect/tsgo": "0.45.0",
        "@types/node": "25.9.6",
        "babel-plugin-annotate-pure-calls": "0.5.0",
        "effect": "4.0.0-rc.115",
        "madge": "8.0.0",
        "oxfmt": "0.67.0",
        "oxlint": "1.82.0",
        "oxlint-tsgolint": "7.0.2001",
        "redis": "6.2.1",
        "rimraf": "6.1.3",
        "tsx": "4.23.13",
        "typescript": "7.0.2"
    },
    "peerDependencies": {
        "effect": "4.0.0-rc.115"
    },
    "engines": {
        "node": ">=18.0.0"
    },
    "packageManager": "pnpm@12.4.1+sha512.2e81e399d73fe8390dab25e06aa788ab7a5908248d2f5a370f82b481147a6a7a367bf8048f9a6fdb6460f21a66f0542dedb8b94ca2c8723596741920b1656d4c"
}
