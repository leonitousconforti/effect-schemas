{
    "name": "effect-schemas",
    "version": "0.0.27",
    "description": "Shared schemas for Effect-TS",
    "keywords": [
        "effect-ts"
    ],
    "homepage": "https://github.com/leonitousconforti/effect-schemas",
    "bugs": {
        "url": "https://github.com/leonitousconforti/effect-schemas/issues",
        "email": "leo@leoconforti.us"
    },
    "license": "GPL-3.0-only",
    "author": "Leo Conforti <leo@leoconforti.us> (https://leoconforti.us)",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/leonitousconforti/effect-schemas.git"
    },
    "files": [
        "src/**/*.ts",
        "dist/**/*.js",
        "dist/**/*.js.map",
        "dist/**/*.d.ts",
        "dist/**/*.d.ts.map"
    ],
    "type": "module",
    "sideEffects": [],
    "exports": {
        "./package.json": "./package.json",
        ".": "./src/index.ts",
        "./*": "./src/*.ts",
        "./internal/*": null,
        "./*/index": null
    },
    "publishConfig": {
        "exports": {
            "./package.json": "./package.json",
            ".": "./dist/index.js",
            "./*": "./dist/*.js",
            "./internal/*": null,
            "./*/index": null
        },
        "access": "public",
        "provenance": true
    },
    "scripts": {
        "prepare": "effect-tsgo patch --typescript --oxlint",
        "clean": "rimraf *.tsbuildinfo docs dist coverage",
        "circular": "madge --circular src/*.ts",
        "codegen": "build-utils prepare-v4",
        "check": "tsc -b tsconfig.json",
        "lint": "oxlint && oxfmt --check",
        "lint-fix": "oxlint --fix && oxfmt --write",
        "build": "tsc -b tsconfig.build.json && pnpm babel",
        "babel": "babel dist --plugins annotate-pure-calls --out-dir dist --source-maps",
        "changeset-version": "changeset version",
        "changeset-publish": "pnpm build && changeset publish"
    },
    "devDependencies": {
        "@babel/cli": "8.0.4",
        "@babel/core": "8.0.1",
        "@babel/plugin-transform-export-namespace-from": "8.0.1",
        "@babel/plugin-transform-modules-commonjs": "8.0.1",
        "@changesets/cli": "3.0.1",
        "@changesets/config": "4.0.0",
        "@effect/build-utils": "0.8.9",
        "@effect/docgen": "4.0.0-rc.111",
        "@effect/tsgo": "0.37.0",
        "@types/node": "25.9.5",
        "babel-plugin-annotate-pure-calls": "0.5.0",
        "effect": "4.0.0-rc.111",
        "madge": "8.0.0",
        "oxfmt": "0.65.0",
        "oxlint": "1.80.0",
        "oxlint-tsgolint": "7.0.2001",
        "redis": "6.2.1",
        "rimraf": "6.1.3",
        "tsx": "4.23.12",
        "typescript": "7.0.2"
    },
    "peerDependencies": {
        "effect": "4.0.0-rc.111"
    },
    "engines": {
        "node": ">=18.0.0"
    },
    "packageManager": "pnpm@11.24.0+sha512.bd27e345e976dcb0be0b7a1228217b049a817e21b1f355c90dbe7dc46671895a8bc1e6d06c24554505ea93ea0b45f489a27ec1bfbc8de6a9659fca0f16fa0000"
}
